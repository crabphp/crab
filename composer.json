{
  "name": "crabphp/crab",
  "type": "project",
  "require": {
    "php": "^8.2",
    "workerman/workerman": "^4.1",
    "nyholm/psr7": "^1.8",
    "psr/http-message": "^1.1",
    "psr/http-server-handler": "^1.0",
    "psr/http-server-middleware": "^1.0"
  },
  "require-dev": {
    "carthage-software/mago": "^1.3"
  },
  "autoload": {
    "psr-4": {
      "Crab\\Engine\\": "../engine/src/",
      "App\\": "app/"
    }
  },
  "config": {
    "allow-plugins": {
      "carthage-software/mago": true
    }
  }
}
