{
    "name": "crabphp/crab",
    "description": "A starting point for an application on the Crab framework",
    "type": "project",
    "require": {
        "php": "^8.4",
        "crabphp/framework": "^0.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "@php vendor/bin/phpunit",
        "post-create-project-cmd": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ]
    },
    "prefer-stable": true
}
