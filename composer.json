{
  "name": "crabphp/crab",
  "type": "project",
  "require": {
    "php": "^8.2",
    "crabphp/engine": "dev-main",
    "workerman/workerman": "^4.1",
    "nyholm/psr7": "^1.8",
    "psr/http-message": "^1.1",
    "psr/http-server-handler": "^1.0",
    "psr/http-server-middleware": "^1.0",
    "psr/container": "^2.0"
  },
  "require-dev": {
    "carthage-software/mago": "^1.3"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "repositories": [
    {
      "type": "path",
      "url": "../engine",
      "options": {
        "symlink": true
      }
    }
  ],
  "config": {
    "allow-plugins": {
      "carthage-software/mago": true
    }
  }
}
