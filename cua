<?php

use Crab\Engine\Config\ConfigServiceProvider;
use Crab\Engine\Console\ConsoleServiceProvider;
use Crab\Engine\Console\Kernel;
use Crab\Engine\Foundation\Application;

$autoload = __DIR__ . '/vendor/autoload.php';
if (file_exists($autoload)) {
    require_once $autoload;
}

$app = new Application(__DIR__);
$container = $app->container();
(new ConfigServiceProvider($container))->register();
(new ConsoleServiceProvider($container))->register();

$kernel = $container->make(Kernel::class);
exit($kernel->handle($argv));
